# === AI — proveedor de lenguaje ===
AI_PROVIDER=groq
AI_API_KEY=gsk_tu_key_aqui
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_WHISPER_MODEL=whisper-1

# === WhatsApp (proveedor activo: Meta Cloud API) ===
WHATSAPP_PROVIDER=meta
META_ACCESS_TOKEN=EAAT...tu_token
META_PHONE_NUMBER_ID=1185525421321347
META_VERIFY_TOKEN=mi_verify_token_123
# Secret para validar la firma HMAC del webhook (X-Hub-Signature-256).
# Con STRICT_WEBHOOK_FIRMA=true, el webhook se rechaza si no hay secret.
META_APP_SECRET=
STRICT_WEBHOOK_FIRMA=true
# Webhook que debes registrar en Meta for Developers (campo messages):
#   https://tudominio.com/webhook/meta
#   token de verificación = META_VERIFY_TOKEN

# === App ===
APP_URL=https://tudominio.com
# Orígenes CORS adicionales separados por coma (además de APP_URL). Vacío por defecto.
CORS_ORIGINS=
# Token compartido para proteger los webhooks legacy (/webhook/whatsapp, /webhook/zapi).
# Si se configura, esos endpoints exigen "Authorization: Bearer <token>".
WEBHOOK_AUTH_TOKEN=
SECRET_KEY=cambiar_en_produccion_123  # fijar un valor persistente una sola vez
ADMIN_PASSWORD=  # si queda vacío, el panel admin exige configurarlo
HOST=0.0.0.0
PORT=8000

# === Base de datos ===
# Local (SQLite):
DATABASE_URL=sqlite:///./storage/tutelas.db
# Postgres (Neon con pooler — la app lo detecta y ajusta pool_pre_ping):
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# === Almacenamiento de archivos (PDFs, pruebas, constancias) ===
# Local: storage/   En Render con volume montado en /data: /data/storage
STORAGE_DIR=storage

# === Mercado Pago (pasarela de pagos — Checkout Pro) ===
MERCADOPAGO_ACCESS_TOKEN=APP_USR_xxx  # o TEST-xxx en modo sandbox
MERCADOPAGO_WEBHOOK_SECRET=tu_secret_webhook
MERCADOPAGO_ENV=sandbox
# MERCADOPAGO_ENV=production
MERCADOPAGO_AMOUNT=29000
MERCADOPAGO_CURRENCY=COP
# Webhook que debes registrar en Mercado Pago (panel, notificaciones):
#   https://tudominio.com/webhook/mercadopago
# Nota: Mercado Pago solo aprueba cuentas productivas con un sitio web.
#   Se usa la propia URL de la app (APP_URL) como "sitio web".

# === Rama Judicial / Radicación ===
RAMA_JUDICIAL_URL=https://procesojudicial.ramajudicial.gov.co/TutelaEnLinea
BROWSER_HEADLESS=true
SIMULATE_BOT=true
TWOCAPTCHA_API_KEY=
# Radicación automática nocturna (Playwright) — offline en producción hasta validar el bot
ENABLE_SCHEDULER=false

# === Horario de radicación automática ===
FILING_HOUR=8
FILING_MINUTE=5
